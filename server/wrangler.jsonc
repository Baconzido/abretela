// Servidor próprio do AbreTela (ROADMAP, seção 6): um Worker e uma sala
// (Durable Object com SQLite, o único aceito no plano grátis). O app monta e
// publica isto na conta da pessoa pela API (fase S2); este arquivo serve para
// rodar localmente (`npx wrangler dev -c server/wrangler.jsonc`).
{
  "name": "abretela",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
